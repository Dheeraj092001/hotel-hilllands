{
  "name": "hotel-hilllands",
  "private": true,
  "version": "1.0.0",
  "description": "Hotel Newlands Shimla — Full-Stack Hotel Management Platform",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @hotel/web run dev",
    "dev:admin": "pnpm --filter @hotel/admin run dev",
    "dev:server": "pnpm --filter @hotel/server run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @hotel/server run db:generate",
    "db:migrate": "pnpm --filter @hotel/server run db:migrate",
    "db:seed": "pnpm --filter @hotel/server run db:seed",
    "db:studio": "pnpm --filter @hotel/server run db:studio"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "protobufjs"
    ]
  }
}
