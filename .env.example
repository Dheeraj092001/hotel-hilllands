# ============================================================
# HOTEL NEWLANDS SHIMLA - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── DATABASE ───────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/hotel_newlands"

# ─── SERVER ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ─── FIREBASE ADMIN (Server Only) ───────────────────────────
FIREBASE_PROJECT_ID=newlands-shimla
FIREBASE_CLIENT_EMAIL=your-service-account@newlands-shimla.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ─── FIREBASE CLIENT (Frontend) ─────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyBK_FbSalNL0RQ-_IG46wiqJtVGY5aUzp0
VITE_FIREBASE_AUTH_DOMAIN=newlands-shimla.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=newlands-shimla
VITE_FIREBASE_STORAGE_BUCKET=newlands-shimla.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=509368232388
VITE_FIREBASE_APP_ID=1:509368232388:web:f5aa92c1b3455109cf5c91
VITE_FIREBASE_MEASUREMENT_ID=G-DZK4KJX36S

# ─── RAZORPAY ───────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX

# ─── CLOUDINARY ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── EMAIL ──────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="Hotel Newlands Shimla <noreply@hotelnewlandsshimla.com>"

# ─── REDIS (Optional) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── URLS ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api/v1
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# ─── INVOICE ────────────────────────────────────────────────
INVOICE_PREFIX=NLS
